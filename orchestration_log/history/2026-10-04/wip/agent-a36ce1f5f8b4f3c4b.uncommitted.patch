+/// `Err(Locked)` past the failure cap, `Err(Rejected)` otherwise; DB errors map to `Rejected`
+/// after logging.
+pub async fn verify_otp_for_phone(pool: &PgPool, phone: &str, code: &str, client_ip: &str) -> Result<(), OtpVerifyError> {
