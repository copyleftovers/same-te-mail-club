++        (None, None) => Ok(None),
++        (Some(phone), Some(name)) => {
++            let phone = crate::phone::normalize(&phone)
++                .map_err(|_| ConfigError::InvalidAdminPhone(phone.clone()))?;
++            Ok(Some(AdminBootstrap { phone, name }))
++        }
++        _ => Err(ConfigError::AdminBootstrapIncomplete),
++    }
