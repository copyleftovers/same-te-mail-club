+                            >
+                                {t!(
+                                    i18n,
+                                    admin_invite_codes_status_used
+                                )}
+                            </span>
+                        }
+                        .into_any()
+                    }
+                    InviteCodeStatus::Revoked => {
+                        view! {
+                            <span
+                                class="badge"
+                                data-testid="invite-code-status-badge"
+                                data-status="revoked"
