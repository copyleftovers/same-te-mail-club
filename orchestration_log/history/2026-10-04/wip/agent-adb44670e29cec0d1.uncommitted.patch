+fn render_saved_address(
+    city: String,
+    branch_number: i32,
+    set_editing_address: WriteSignal<bool>,
+    hydrated: ReadSignal<bool>,
+    i18n: leptos_i18n::I18nContext<crate::i18n::i18n::Locale>,
+) -> AnyView {
+    let branch_text = t!(
+        i18n,
+        home_recipient_branch,
+        branch_number = branch_number,
+        city = city
+    );
+    view! {
+        // Framed card + explicit "saved" label distinguishes this
+        // reuse-my-address branch from the fresh-entry input fields,
+        // which otherwise occupy the same slot.
+        <article class="card" data-testid="existing-address">
+            <dl class="info-list">
+                <div class="info-item">
+                    <dt class="info-label">{t!(i18n, home_saved_address_label)}</dt>
+                    <dd class="info-value">{branch_text}</dd>
+                </div>
+            </dl>
+            <p class="text-sm text-(--color-text-muted) mt-(--density-space-sm)">
+                {t!(i18n, home_saved_address_note)}
+            </p>
+            <button
+                type="button"
+                class="btn"
+                data-variant="link"
+                data-testid="change-address-button"
+                disabled=move || !hydrated.get()
+                on:click=move |_| set_editing_address.set(true)
+            >
+                {t!(i18n, home_change_address_button)}
+            </button>
+        </article>
+        <input type="hidden" name="use_existing_address" value="true" />
+        // city and np_number are required by form deserialization but
+        // ignored by the server when use_existing_address is true.
+        <input type="hidden" name="city" value="" />
+        <input type="hidden" name="np_number" value="" />
+    }
+    .into_any()
+}
+
+/// City + branch inputs for a new delivery address (+ `use_existing_address=false`).
+/// `current` (the saved address) only fills placeholders, never `value`.
+fn render_new_address_fields(
+    city_error: impl Fn() -> Option<String> + Copy + Send + Sync + 'static,
+    np_number_error: impl Fn() -> Option<String> + Copy + Send + Sync + 'static,
+    current: Option<(String, i32)>,
+    i18n: leptos_i18n::I18nContext<crate::i18n::i18n::Locale>,
+) -> AnyView {
+    let (city_placeholder, number_placeholder) = match current {
+        Some((city, branch_number)) => (city, branch_number.to_string()),
+        None => ("Київ".to_owned(), "123".to_owned()),
+    };
+    view! {
+        <input type="hidden" name="use_existing_address" value="false" />
+        <div class="flex flex-col gap-(--density-space-md) sm:flex-row sm:gap-(--density-space-sm)">
+            <div class="field sm:w-1/2">
+                <label class="field-label" for="enroll-city">
+                    {t!(i18n, home_city_label)}
+                </label>
+                <input
+                    class="field-input"
+                    type="text"
+                    id="enroll-city"
+                    name="city"
+                    placeholder=city_placeholder
+                    data-testid="np-city-input"
+                    aria-invalid=move || city_error().is_some().then_some("true")
+                    aria-describedby="enroll-city-error"
+                />
+                <p
+                    id="enroll-city-error"
+                    class="field-error"
+                    aria-live="assertive"
+                    data-testid="enroll-city-error"
+                >
+                    {move || city_error()}
+                </p>
+            </div>
+            <div class="field sm:w-1/2">
+                <label class="field-label" for="enroll-number">
+                    {t!(i18n, home_np_number_label)}
+                </label>
+                <input
+                    class="field-input"
+                    id="enroll-number"
+                    type="text"
+                    inputmode="numeric"
+                    name="np_number"
+                    placeholder=number_placeholder
+                    data-testid="np-number-input"
+                    aria-invalid=move || np_number_error().is_some().then_some("true")
+                    aria-describedby="enroll-number-error"
+                />
+                <p
+                    id="enroll-number-error"
+                    class="field-error"
+                    aria-live="assertive"
+                    data-testid="enroll-number-error"
+                >
+                    {move || np_number_error()}
+                </p>
+            </div>
+        </div>
+    }
+    .into_any()
+}
