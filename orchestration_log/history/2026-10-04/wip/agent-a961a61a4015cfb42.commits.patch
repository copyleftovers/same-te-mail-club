From: Claude <noreply@anthropic.com>
Date: Mon, 5 Oct 2026 20:44:42 +0000
Subject: [PATCH] feat(db): add seasons.meetup_details column

---
 migrations/20261004000002_add_season_meetup_details.sql | 5 +++++
 1 file changed, 5 insertions(+)
 create mode 100644 migrations/20261004000002_add_season_meetup_details.sql

diff --git a/migrations/20261004000002_add_season_meetup_details.sql b/migrations/20261004000002_add_season_meetup_details.sql
new file mode 100644
index 0000000..8ca114e
--- /dev/null
+++ b/migrations/20261004000002_add_season_meetup_details.sql
@@ -0,0 +1,5 @@
+-- Organizer's free-text meetup announcement (date, time, place).
+-- NULL = not announced yet.
+ALTER TABLE seasons
+    ADD COLUMN meetup_details TEXT
+    CHECK (meetup_details IS NULL OR char_length(meetup_details) BETWEEN 1 AND 300);
-- 
