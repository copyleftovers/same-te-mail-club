-#[server(ListInviteCodes)]
-pub async fn list_invite_codes() -> Result<Vec<InviteCodeRow>, ServerFnError> {
-    use crate::auth;
-
-    let (pool, _admin) = auth::require_admin().await?;
-
-    let rows = sqlx::query_as!(
-        InviteCodeQueryRow,
-        r#"
