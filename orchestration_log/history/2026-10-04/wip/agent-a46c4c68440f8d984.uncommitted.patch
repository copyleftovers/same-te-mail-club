-    .await?
-    .ok_or(AppError::Unauthorized)?;
-
-    if row.status != UserStatus::Active {
-        return Err(AppError::Unauthorized);
-    }
-
-    Ok(CurrentUser {
-        id: user_id,
-        name: row.name,
-        role: row.role,
