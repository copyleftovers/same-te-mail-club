-            ON CONFLICT (user_id, season_id) DO NOTHING
-            "#,
-            &notified_user_ids,
-            season_id,
-        )
-        .execute(&pool)
-        .await;
-    }
-
-    let sent = u32::try_from(notified_user_ids.len()).unwrap_or(u32::MAX);
-    let failed = u32::try_from(failed_phones.len()).unwrap_or(u32::MAX);
