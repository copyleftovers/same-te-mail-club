-            let w = edge_weight(current, participants[i], social_weights);
-            candidates.push((w, i));
-        }
-    }
-    candidates.sort_unstable();
-
-    for (_, idx) in candidates {
-        visited[idx] = true;
-        path.push(participants[idx]);
-
-        if backtrack(path, visited, participants, social_weights, n) {
-            return true;
-        }
-
-        path.pop();
-        visited[idx] = false;
-    }
-
-    false
-}
