+            .await
+            .expect("admin bootstrap failed");
+        tracing::info!(phone = %admin.phone, "admin bootstrap ensured");
+    }
+
     // 3b. Shared HTTP client for SMS delivery
     let http_client = samete::sms::build_http_client().expect("HTTP client build failed");
 
