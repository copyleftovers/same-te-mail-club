+        assert!(
+            config
+                .check_bind_addr("127.0.0.1:3000".parse().expect("addr"))
+                .is_ok()
+        );
+    }
+
+    #[test]
+    fn non_test_mode_allows_any_bind() {
+        let config = config_with(SmsMode::DryRun { test_mode: false });
+        assert!(
+            config
+                .check_bind_addr("0.0.0.0:3000".parse().expect("addr"))
+                .is_ok()
+        );
+    }
 }
