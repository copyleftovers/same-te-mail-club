+/// First admin ensured at every boot (idempotent).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AdminBootstrap {
+    /// E.164-normalized phone.
+    pub phone: String,
+    pub name: String,
 }
 
