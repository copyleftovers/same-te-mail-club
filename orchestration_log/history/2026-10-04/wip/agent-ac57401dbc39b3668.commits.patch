diff --git a/src/config.rs b/src/config.rs
index b0292bf..540ac89 100644
--- a/src/config.rs
+++ b/src/config.rs
@@ -5,6 +5,8 @@ pub struct Config {
     pub turbosms_sender: String,
     // CSRF: SameSite=Strict cookie attribute is the mitigation (see src/pages/login.rs set_cookie_header)
     pub sms_dry_run: bool,
+    /// Public https URL of the app, appended to every participant SMS.
+    pub site_url: String,
 }
 
 #[derive(Debug, thiserror::Error)]
@@ -19,6 +21,34 @@ pub enum ConfigError {
     EmptyTurbosmsToken,
     #[error("TURBOSMS_SENDER must not be empty")]
     EmptyTurbosmsSender,
+    #[error("missing SAMETE_SITE_URL (required when SMS are sent)")]
+    MissingSiteUrl,
+    #[error("SAMETE_SITE_URL must be an https:// URL, got {0}")]
+    InvalidSiteUrl(String),
+}
+
+/// Public URL used in dry-run mode (local dev / E2E), where SMS are only logged.
+const DRY_RUN_SITE_URL: &str = "http://127.0.0.1:3000";
+
+/// Parse `SAMETE_SITE_URL`: required (https) when SMS are live; dry-run defaults
+/// to [`DRY_RUN_SITE_URL`]. Trailing `/` and surrounding whitespace are trimmed.
+fn site_url_from_var(raw: Option<String>, sms_live: bool) -> Result<String, ConfigError> {
+    let Some(raw) = raw else {
+        return if sms_live {
+            Err(ConfigError::MissingSiteUrl)
+        } else {
+            Ok(DRY_RUN_SITE_URL.to_owned())
+        };
+    };
+    let url = raw.trim().trim_end_matches('/');
+    let has_host = url
+        .strip_prefix("https://")
+        .is_some_and(|host| !host.is_empty());
+    if has_host {
+        Ok(url.to_owned())
+    } else {
+        Err(ConfigError::InvalidSiteUrl(url.to_owned()))
+    }
 }
 
 impl Config {
@@ -32,6 +62,9 @@ impl Config {
     /// must be present and non-empty. An empty bearer token would cause a 401
     /// at the first SMS send.
     ///
+    /// `SAMETE_SITE_URL` (https) is appended to participant SMS: required when
+    /// SMS are live, defaulted in dry-run.
+    ///
     /// # Errors
     ///
     /// Returns `Err` if any required environment variable is absent or empty.
@@ -63,11 +96,61 @@ impl Config {
             sender
         };
 
+        let site_url = site_url_from_var(std::env::var("SAMETE_SITE_URL").ok(), !sms_dry_run)?;
+
         Ok(Self {
             database_url,
             turbosms_token,
             turbosms_sender,
             sms_dry_run,
+            site_url,
         })
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::{ConfigError, DRY_RUN_SITE_URL, site_url_from_var};
+
+    #[test]
+    fn site_url_defaults_in_dry_run() {
+        assert_eq!(
+            site_url_from_var(None, false).ok().as_deref(),
+            Some(DRY_RUN_SITE_URL)
+        );
+    }
+
+    #[test]
+    fn site_url_required_for_live_sms() {
+        assert!(matches!(
+            site_url_from_var(None, true),
+            Err(ConfigError::MissingSiteUrl)
+        ));
+    }
+
+    #[test]
+    fn site_url_trims_whitespace_and_trailing_slash() {
+        assert_eq!(
+            site_url_from_var(Some(" https://club.example.ua/ ".into()), true)
+                .ok()
+                .as_deref(),
+            Some("https://club.example.ua")
+        );
+    }
+
+    #[test]
+    fn site_url_rejects_plain_http() {
+        assert!(matches!(
+            site_url_from_var(Some("http://club.example.ua".into()), false),
+            Err(ConfigError::InvalidSiteUrl(_))
+        ));
+    }
+
+    #[test]
+    fn site_url_rejects_bare_scheme() {
+        assert!(matches!(
+            site_url_from_var(Some("https://".into()), false),
+            Err(ConfigError::InvalidSiteUrl(_))
+        ));
+    }
+}
