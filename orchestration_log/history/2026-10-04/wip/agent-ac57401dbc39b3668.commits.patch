+/// Append the app link: every participant SMS asks the reader to act in the app.
+#[cfg(any(feature = "ssr", test))]
+fn with_site_link(body: &str, site_url: &str) -> String {
+    format!("{body} {site_url}")
+}
+
 // ── Server functions ───────────────────────────────────────────────────────────
 //
