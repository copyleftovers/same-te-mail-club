From: Claude <noreply@anthropic.com>
Date: Mon, 5 Oct 2026 20:44:38 +0000
Subject: [PATCH] docs(assignments): correct season lock comment to what the
 lock guarantees

---
 src/admin/assignments.rs | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/admin/assignments.rs b/src/admin/assignments.rs
index 347443c..160540f 100644
--- a/src/admin/assignments.rs
+++ b/src/admin/assignments.rs
@@ -295,7 +295,8 @@ pub async fn swap_assignment(
 
     let mut tx = pool.begin().await.map_err(db_err)?;
 
-    // Lock the season row: serializes concurrent swaps and advance_season.
+    // Lock the season row: serializes concurrent swaps, and makes advance_season's
+    // phase UPDATE wait until this swap commits.
     let phase = sqlx::query_scalar!(
         r#"
         SELECT phase AS "phase: Phase"
