+/// Why a set of assignments is not a releasable cycle structure.
+#[derive(Debug, PartialEq, Eq, thiserror::Error)]
+pub enum CycleError {
+    #[error("no assignments")]
+    NoAssignments,
+    #[error("cohort {cohort} has fewer than 3 participants")]
+    CohortTooSmall { cohort: usize },
+    #[error("cohort {cohort}: duplicate participant {participant}")]
+    DuplicateInCohort { cohort: usize, participant: Uuid },
+    #[error("participant {sender} sends to both {first} and {second}")]
+    SendsTwice {
+        sender: Uuid,
+        first: Uuid,
+        second: Uuid,
+    },
+    #[error("participant {recipient} receives from both {first} and {second}")]
+    ReceivesTwice {
+        recipient: Uuid,
+        first: Uuid,
+        second: Uuid,
+    },
+    #[error("participant {0} has more than one assignment")]
+    DuplicateSender(Uuid),
+    #[error("participant {0} is reached twice")]
+    ReachedTwice(Uuid),
+    #[error("participant {0} has no assignment")]
+    Unassigned(Uuid),
+}
+
 /// Validate that a set of assignments forms valid cycles.
 ///
 /// Every participant sends to exactly one, receives from exactly one.
