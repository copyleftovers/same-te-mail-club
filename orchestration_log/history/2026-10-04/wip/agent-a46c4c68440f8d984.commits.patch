         if n < 3 {
-            return Err(format!("cohort {cohort_idx} has fewer than 3 participants"));
+            return Err(CycleError::CohortTooSmall { cohort: cohort_idx });
         }
 
         // Check cycle forms a single loop: each participant sends to the next.
