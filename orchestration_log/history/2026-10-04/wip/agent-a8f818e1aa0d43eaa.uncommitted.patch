+impl ReceiptStatus {
+    /// Participant-driven receipt transitions: a first answer, or correcting a
+    /// `NotReceived` report when the mail arrives late. `Received` is final.
+    #[must_use]
+    pub fn can_transition_to(self, next: Self) -> bool {
+        matches!(
+            (self, next),
+            (Self::NoResponse, Self::Received | Self::NotReceived)
+                | (Self::NotReceived, Self::Received)
+        )
+    }
+}
+
 /// Invite code lifecycle status — mirrors `invite_code_status` Postgres enum.
 ///
 /// - `Unused`: code has been generated but not yet redeemed by any participant.
@@ -249,4 +264,30 @@ mod tests {
